# MoxSignal default environment for direct binary deployment.
# Copy this file and replace database credentials before running in production.

MOXSIGNAL_ADDR=:8982
MOXSIGNAL_DB_DSN=postgres://moxsignal:change-me@127.0.0.1:5432/moxsignal?sslmode=disable
MOXSIGNAL_PUBLIC_BASE_URL=

MOXSIGNAL_CHALLENGE_TTL_SECONDS=60
MOXSIGNAL_WS_TOKEN_TTL_SECONDS=900
MOXSIGNAL_EVENT_TTL_SECONDS=120
MOXSIGNAL_START_CALL_RATE_PER_MIN=30
MOXSIGNAL_WS_MESSAGE_RATE_PER_SEC=60
MOXSIGNAL_AUTH_FAIL_WINDOW_MINUTES=30
MOXSIGNAL_AUTH_FAIL_BAN_MINUTES=30
MOXSIGNAL_AUTH_FAIL_BAN_THRESHOLD=10

# Optional ICE distribution. Example:
# MOXSIGNAL_RTC_ICE_SERVERS='[{"urls":["stun:stun.example.com:3478"]},{"urls":["turn:turn.example.com:3478?transport=udp"],"username":"user","credential":"secret"}]'
MOXSIGNAL_RTC_ICE_SERVERS=

# Group SFU media settings.
MOXSIGNAL_SFU_UDP_PORT=18982
MOXSIGNAL_SFU_PUBLIC_IPS=
MOXSIGNAL_SFU_PUBLIC_IPS_AS_HOST=false
MOXSIGNAL_SFU_UDP4_ONLY=true
MOXSIGNAL_SFU_TOKEN_SECRET=
MOXSIGNAL_SFU_TOKEN_TTL_SECONDS=120
MOXSIGNAL_SFU_ICE_DISCONNECTED_SECONDS=8
MOXSIGNAL_SFU_ICE_FAILED_SECONDS=25
MOXSIGNAL_SFU_ICE_KEEPALIVE_SECONDS=2
